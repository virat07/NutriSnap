{
  "expo": {
    "name": "NutriSnap",
    "slug": "NutriSnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/NutriSnap.png",
    "scheme": "nutrisnap",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "NutriSnap",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/NutriSnap.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.NutriSnap"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/NutriSnap.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/NutriSnap.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0777fe59-fcb2-45ed-a014-e41c3ff86a5c"
      }
    }
  }
}
